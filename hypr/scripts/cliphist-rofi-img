#!/bin/bash

THUMB_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-thumbs"
CLIP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-clipboard-list"
mkdir -p "$THUMB_DIR"

sanitize() { printf '%s\n' "$1" | tr -cd '[:print:]'; }

emit_image() {
  local id="$1" rest="$2" raw="$3" ext src prev
  if [[ "$rest" =~ binary[[:space:]]data.*[[:space:]](jpe?g|png|webp|gif|bmp)[[:space:]] ]]; then
    ext="${BASH_REMATCH[1]}"
    src="$THUMB_DIR/$id.$ext"
    if [ ! -f "$src" ] || [ ! -s "$src" ]; then
      printf '%s\n' "$raw" | cliphist decode 2>/dev/null > "$src"
    fi
    prev="$THUMB_DIR/$id.prev.png"
    if [ ! -f "$prev" ] && [ -s "$src" ]; then
      magick "$src" -auto-orient -strip -resize '256x256>' "$prev" 2>/dev/null
    fi
    if [ -s "$prev" ]; then
      # rofi 2.0 renders \0icon only when the row has no \0display
      printf '%s\0icon\x1f%s\n' "$raw" "$prev"
      return 0
    fi
  fi
  return 1
}

print_list() {
  local rows line id rest
  # mostly everything, still instant (thumbnails are pre-warmed)
  mapfile -t rows < <(cliphist list | head -500)
  # keep rofi from jumping to the top (or resetting the filter) after a refresh
  printf '\0keep-selection\x1ftrue\n\0keep-filter\x1ftrue\n'
  # enable custom keybindings (V -> RETV 10)
  printf '\0use-hot-keys\x1ftrue\n'
  # natural cliphist order: most recently copied at the top
  for line in "${rows[@]}"; do
    [ -z "$line" ] && continue
    id="${line%%$'\t'*}"; rest="${line#*$'\t'}"
    if [[ "$rest" =~ binary[[:space:]]data ]]; then
      if ! emit_image "$id" "$rest" "$line"; then
        # image row without a preview (e.g. corrupt clip) - keep it in place, text only
        printf '%s\0display\x1f%s\n' "$line" "$rest"
      fi
    else
      printf '%s\t%s\0display\x1f%s\n' "$id" "$rest" "$(sanitize "$rest")"
    fi
  done
}

if [ "${CLIP_CACHE_MODE:-}" = "warm" ]; then
  print_list > "$CLIP_CACHE" 2>/dev/null
  exit 0
fi

if [ -z "$1" ] || [ "${ROFI_RETV:-0}" = "0" ]; then
  # open from the pre-built cache for instant load
  [ -f "$CLIP_CACHE" ] && cat "$CLIP_CACHE" || print_list
  exit 0
fi

case "${ROFI_RETV:-1}" in
  # D pressed -> delete this entry from cliphist and refresh the menu
  3)
    printf '%s\n' "$1" | cliphist delete 2>/dev/null
    print_list
    ;;
  # V pressed -> open the image fullscreen in the default viewer (feh)
  10)
    LOG=$HOME/Documents/log/rofi-v.log
    mkdir -p "$(dirname "$LOG")"
    echo "RETV=$ROFI_RETV arg=${1:0:60}" >> "$LOG"
    id="${1%%$'\t'*}"
    f="$THUMB_DIR/clip-open-$id.png"
    printf '%s\n' "$1" | cliphist decode 2>/dev/null > "$f"
    if [ -s "$f" ]; then
      setsid feh --fullscreen --zoom fill "$f" >/dev/null 2>&1 &
    fi
    ;;
  *) echo "RETV=$ROFI_RETV arg=${1:0:60}" >> "$HOME/Documents/log/rofi-v.log" 2>/dev/null
     echo "$1" | cliphist decode | wl-copy ;;
esac
