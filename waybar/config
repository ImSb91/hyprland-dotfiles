{ 

  "position": "top",
  "exlusive": "true",
  "passthrough": "true",
  "gtk-layer-shell": "true",
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "height": 41,
  "modules-left": [
    "custom/weather",
    "cpu",
    "memory",
    "disk",
    "backlight",
    "custom/battery",
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/language",
    "pulseaudio",
    "pulseaudio#microphone",
    "clock",
    "separator",
    "tray"
  ],


  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 2, 
  },
   "custom/spacer": {
        "format": " ", // Empty space
        "tooltip": false
  },
  "separator": {
    "format": " | "
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "disactivate",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-click-right": "",
    "on-click-middle": "",
    "on-click-forward": "",
    "on-click-backward": "",

 
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "active": "",
      "urgent": "",
      "persistent": "",
      "focused": "",
      "default": "",
              },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9,
      "DP-1": 9
    }
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#89b4fa'>󰥔 </span><span color='#cdd6f4'>{:%H:%M | %a %d %b}</span>",
  },

  "cpu": {
    "format": "<span color='#89b4fa'>󰍛</span> <span color='#cdd6f4'>{usage}%</span>",
    "interval": 1,

  },
  "memory": {
    "interval": 3,
    "format": "<span color='#f38ba8'> </span> <span color='#cdd6f4'>{used:0.1f}G</span>"
  },
   

"custom/weather": {
    "exec": "~/.config/hypr/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "format": "{text}"
},


 

"pulseaudio": {
  "format": "<span color='#a6e3a1'>{icon} </span><span color='#cdd6f4'>{volume}%</span>",
  "format-bluetooth": "<span color='#a6e3a1'>{icon}</span> <span color='#cdd6f4'>{volume}%</span>",
  "tooltip": false,
  "format-muted": "{icon}",   // <- use {icon} here instead of hardcoding
  "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
  "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 1%+",
  "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 1%-",
  "format-icons": {
    "headphone": "<span color='#a6e3a1'>󰋋</span>",
    "headphone-muted": "<span color='#f38ba8'>󰟎</span>",
    "headset": "<span color='#a6e3a1'>󰋋</span>",
    "headset-muted": "<span color='#f38ba8'>󰟎</span>",
    "hands-free": "<span color='#a6e3a1'></span>",
    "hands-free-muted": "<span color='#f38ba8'>󰟎</span>",
    "phone": "<span color='#a6e3a1'></span>",
    "phone-muted": "<span color='#f38ba8'>󰍪</span>",
    "portable": "<span color='#a6e3a1'></span>",
    "portable-muted": "<span color='#f38ba8'>󰍪</span>",
    "car": "<span color='#a6e3a1'></span>",
    "car-muted": "<span color='#f38ba8'>󰄟</span>",
    "default": [
      "<span color='#a6e3a1'></span>",
      "<span color='#a6e3a1'></span>",
      "<span color='#a6e3a1'> </span>"
    ],
    "default-muted": "<span color='#f38ba8'>󰝟</span>"
  }
},


  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#f38ba8'> </span><span color='#cdd6f4'>{volume}%</span>",
    "format-source-muted": " ",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 1%-",
  },

   "hyprland/language": {

  "format": "<span color='#f9e2af'>󰌌</span> <span color='#cdd6f4'>{}</span>",

  "format-ar": "ara",

  "format-en": "eng",
  "keyboard-name": "config.home.keyboard.model",

},
  "disk":{
	"interval": 3, 
  "path": "/home",
	"format": "<span color='#a6e3a1'> </span><span color='#cdd6f4'>{free}</span>",
	"unit": "GB"
},
  "battery": {
  "bat": "BAT0",
  "format": "{icon} {capacity}%",
  "format-charging": "⚡ {capacity}%",
  "format-plugged": "🔌 {capacity}%",
  "tooltip": true,
  "format-icons": ["", "", "", "", ""]
},
"custom/language": {
   "exec": "~/.config/hypr/scripts/language.sh",
  "interval": 1,
  "format": "<span color='#f9e2af'>󰌌</span> {}",
  "return-type": "json"
  },
"backlight": {
  "device": "intel_backlight",
  "format": "<span color=\"#f9e2af\">{icon} </span><span color=\"#cdd6f4\">{percent}%</span>",
  "tooltip-format": "{percent}%",
  "format-icons": ["󰃝", "󰃞","󰃟","󰃠",]
},


"custom/battery": {
  "exec": "~/.config/hypr/scripts/battery.sh",
  "interval": 30,
  "return-type": "json"
},

"custom/fan": {
  "exec": "~/.config/waybar/scripts/fan.sh",
  "interval": 2,
  "return-type": "json",
  "on-click": "~/.config/waybar/scripts/fan.sh up",
  "on-click-right": "~/.config/waybar/scripts/fan.sh down"
}
}
